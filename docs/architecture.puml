@startuml System_Architecture
title AquaWatch — System Architecture\nIoT-Based Water Quality Monitoring & Predictive Alert System for Seabass Aquaculture

skinparam componentStyle rectangle
skinparam defaultTextAlignment center

actor "Farm Worker" as Worker
actor "Administrator" as Admin

node "Tank-side Sensing Unit\n(PVC enclosure, 5V USB)" {
  component "ESP32 Firmware\n(Arduino C++)" as FW
  component "Sensors x4\nWater level | DS18B20\npH | TDS" as SENS
  SENS ..> FW : raw signals\n(median-of-5 filtered)
}

cloud "Firebase Cloud — asia-southeast1" {
  database "Realtime Database\n(single source of truth)" as RTDB
  component "Authentication\n(email+password / anonymous)" as AUTH
  database "Storage\n(report images)" as STOR
  component "Cloud Function\nonAlertCreated (Node 22)" as FN
  component "FCM\nPush Service" as FCM
}

package "Application Layer" {
  component "Worker Mobile App\n(Flutter, Android)" as MOB
  component "Admin Web Dashboard\n(vanilla JS + Firebase SDK)" as WEB
}

' ── Interactions ──────────────────────────────────────────
Worker --> MOB
Admin --> WEB

FW --> AUTH : anonymous sign-in
MOB --> AUTH : email/password\nlogin + register
WEB --> AUTH : admin-gated login

FW --> RTDB : live readings + history\n(alerts on threshold breach)\n[every interval, default 15 s]
RTDB --> FW : thresholds + interval\n(60 s config refresh)

MOB --> RTDB : reports, sensor lifecycle,\nreading frequency
WEB --> RTDB : thresholds (admin-only),\nsent messages

RTDB --> MOB : realtime streams\n(readings, alerts, sensors)
RTDB --> WEB : realtime streams\n(readings, charts, reports)

MOB --> STOR : upload photo evidence
STOR --> MOB : download URLs

RTDB --> FN : on alert created (trigger)
FN --> FCM : multicast to user tokens
FCM --> MOB : push notification\n(banner / sound / vibration)

note bottom of RTDB
  All components communicate exclusively
  through Firebase — no client-to-client
  links. Any client can be replaced
  without touching the others.
end note
@enduml
