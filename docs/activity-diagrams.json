{
  "title": "AquaWatch — Activity Diagram",
  "system": "IoT-Based Water Quality Monitoring and Predictive Alert System for Seabass Aquaculture",
  "description": "UML activity diagrams covering the system's main workflows, expressed in JSON (nodes + edges). Renderable to PlantUML/Mermaid on request.",
  "diagrams": [
    {
      "id": "AD1",
      "name": "ESP32 Reading & Alert Cycle",
      "description": "The core sensing loop executed by the firmware on every sampling interval.",
      "swimlanes": [
        { "id": "esp32", "name": "ESP32 Firmware" },
        { "id": "firebase", "name": "Firebase RTDB" },
        { "id": "cloud", "name": "Cloud Function" },
        { "id": "worker", "name": "Worker Mobile App" }
      ],
      "nodes": [
        { "id": "start", "type": "start", "label": "Power On", "lane": "esp32" },
        { "id": "wifi", "type": "activity", "label": "Connect to Wi-Fi (20s timeout, restart on fail)", "lane": "esp32" },
        { "id": "auth", "type": "activity", "label": "Anonymous Firebase sign-in", "lane": "esp32" },
        { "id": "ntp", "type": "activity", "label": "Sync time via NTP", "lane": "esp32" },
        { "id": "initconfig", "type": "activity", "label": "Fetch thresholds + reading interval", "lane": "esp32" },
        { "id": "waitsched", "type": "activity", "label": "Wait for next scheduled reading (dynamic interval)", "lane": "esp32" },
        { "id": "readsensors", "type": "activity", "label": "Read all 4 sensors (median-of-5 filtering)", "lane": "esp32" },
        { "id": "sensorvalid", "type": "decision", "label": "All sensor responses valid?", "lane": "esp32" },
        { "id": "guardwarn", "type": "activity", "label": "Log 'not responding' warning, use last good value", "lane": "esp32" },
        { "id": "writetankstatus", "type": "activity", "label": "Write live reading to tank_status", "lane": "firebase" },
        { "id": "appendhistory", "type": "activity", "label": "Append reading to TANK_01/history", "lane": "firebase" },
        { "id": "thresholdcheck", "type": "decision", "label": "Any value outside admin thresholds?", "lane": "esp32" },
        { "id": "cooldowncheck", "type": "decision", "label": "Cooldown (5 min) elapsed for this parameter?", "lane": "esp32" },
        { "id": "pushalert", "type": "activity", "label": "Push alert entry (severity + actionTaken)", "lane": "firebase" },
        { "id": "onalertcreated", "type": "activity", "label": "onAlertCreated trigger fires", "lane": "cloud" },
        { "id": "fcmfanout", "type": "activity", "label": "Collect fcmTokens of all users -> multicast FCM push", "lane": "cloud" },
        { "id": "phonering", "type": "activity", "label": "Phone receives push (banner / tray / sound / vibration)", "lane": "worker" },
        { "id": "configrefresh", "type": "activity", "label": "Every 60s: refresh thresholds + interval", "lane": "esp32" },
        { "id": "loop", "type": "activity", "label": "Continue loop", "lane": "esp32" }
      ],
      "edges": [
        { "from": "start", "to": "wifi" },
        { "from": "wifi", "to": "auth" },
        { "from": "auth", "to": "ntp" },
        { "from": "ntp", "to": "initconfig" },
        { "from": "initconfig", "to": "waitsched" },
        { "from": "waitsched", "to": "readsensors" },
        { "from": "readsensors", "to": "sensorvalid" },
        { "from": "sensorvalid", "to": "guardwarn", "label": "no" },
        { "from": "guardwarn", "to": "writetankstatus" },
        { "from": "sensorvalid", "to": "writetankstatus", "label": "yes" },
        { "from": "writetankstatus", "to": "appendhistory" },
        { "from": "appendhistory", "to": "thresholdcheck" },
        { "from": "thresholdcheck", "to": "pushalert", "label": "yes" },
        { "from": "thresholdcheck", "to": "configrefresh", "label": "no" },
        { "from": "pushalert", "to": "cooldowncheck" },
        { "from": "cooldowncheck", "to": "onalertcreated", "label": "yes" },
        { "from": "cooldowncheck", "to": "configrefresh", "label": "no (suppressed)" },
        { "from": "onalertcreated", "to": "fcmfanout" },
        { "from": "fcmfanout", "to": "phonering" },
        { "from": "phonering", "to": "configrefresh" },
        { "from": "configrefresh", "to": "loop" },
        { "from": "loop", "to": "waitsched" }
      ]
    },
    {
      "id": "AD2",
      "name": "Worker Login & Session Resume",
      "description": "App start -> remembered session or fresh login -> dashboard.",
      "nodes": [
        { "id": "start", "type": "start", "label": "App launched" },
        { "id": "gate", "type": "activity", "label": "StartupGate: check session" },
        { "id": "hasuser", "type": "decision", "label": "Firebase user exists AND remember-window (<24h) valid?" },
        { "id": "gohome", "type": "activity", "label": "Navigate to Dashboard (no login)" },
        { "id": "logout", "type": "activity", "label": "Clear stale session (sign out)" },
        { "id": "login", "type": "activity", "label": "Show Login screen" },
        { "id": "entercreds", "type": "activity", "label": "Enter email + password (optional: Register, Forgot Key)" },
        { "id": "authok", "type": "decision", "label": "Firebase Auth success?" },
        { "id": "showerr", "type": "activity", "label": "Show inline error message" },
        { "id": "saveremember", "type": "activity", "label": "Store remember-until (24h if ticked)" },
        { "id": "savetoken", "type": "activity", "label": "Save FCM device token to users/{uid}" },
        { "id": "end", "type": "end", "label": "Dashboard live" }
      ],
      "edges": [
        { "from": "start", "to": "gate" },
        { "from": "gate", "to": "hasuser" },
        { "from": "hasuser", "to": "gohome", "label": "yes" },
        { "from": "hasuser", "to": "logout", "label": "no" },
        { "from": "logout", "to": "login" },
        { "from": "login", "to": "entercreds" },
        { "from": "entercreds", "to": "authok" },
        { "from": "authok", "to": "showerr", "label": "no" },
        { "from": "showerr", "to": "entercreds" },
        { "from": "authok", "to": "saveremember", "label": "yes" },
        { "from": "saveremember", "to": "savetoken" },
        { "from": "savetoken", "to": "gohome" },
        { "from": "gohome", "to": "end" }
      ]
    },
    {
      "id": "AD3",
      "name": "Sensor Lifecycle Management (Worker)",
      "description": "Install -> countdown -> auto status -> replace/inactive alerts -> removal with auto-report.",
      "nodes": [
        { "id": "start", "type": "start", "label": "Worker opens Sensors tab" },
        { "id": "install", "type": "activity", "label": "Install sensor (ID + type + lifespan days)" },
        { "id": "writenode", "type": "activity", "label": "Create TANK_01/sensors/{id} with installedAt + expiresAt" },
        { "id": "autoreport1", "type": "activity", "label": "Auto-log 'Sensor X installed' report" },
        { "id": "countdown", "type": "activity", "label": "Countdown runs (remaining = expiresAt - now)" },
        { "id": "statuscheck", "type": "decision", "label": "Computed status (inactive > replace > active) changed?" },
        { "id": "logtransition", "type": "activity", "label": "Log transition alert (warning if replace, critical if inactive)" },
        { "id": "echo", "type": "activity", "label": "Echo status to sensor node (admin dashboard sees it)" },
        { "id": "phonotify", "type": "activity", "label": "Cloud Function pushes notification to workers" },
        { "id": "confirmremove", "type": "decision", "label": "Worker confirms removal (button / swipe)?" },
        { "id": "hidecard", "type": "activity", "label": "Hide card immediately (same frame)" },
        { "id": "writeremoved", "type": "activity", "label": "Set removedAt + status inactive + critical alert" },
        { "id": "autoreport2", "type": "activity", "label": "Auto-log 'Sensor X removed' report" },
        { "id": "end", "type": "end", "label": "Lifecycle recorded" }
      ],
      "edges": [
        { "from": "start", "to": "install" },
        { "from": "install", "to": "writenode" },
        { "from": "writenode", "to": "autoreport1" },
        { "from": "autoreport1", "to": "countdown" },
        { "from": "countdown", "to": "statuscheck" },
        { "from": "statuscheck", "to": "logtransition", "label": "yes (transition)" },
        { "from": "statuscheck", "to": "confirmremove", "label": "no" },
        { "from": "logtransition", "to": "echo" },
        { "from": "echo", "to": "phonotify" },
        { "from": "phonotify", "to": "confirmremove" },
        { "from": "confirmremove", "to": "hidecard", "label": "yes" },
        { "from": "confirmremove", "to": "countdown", "label": "no (keep monitoring)" },
        { "from": "hidecard", "to": "writeremoved" },
        { "from": "writeremoved", "to": "autoreport2" },
        { "from": "autoreport2", "to": "end" }
      ]
    },
    {
      "id": "AD4",
      "name": "Worker Report Submission (with photos)",
      "description": "Incident reporting with camera/gallery capture, upload, and history.",
      "nodes": [
        { "id": "start", "type": "start", "label": "Worker opens Report tab" },
        { "id": "fill", "type": "activity", "label": "Fill issue + sensor ID + notes" },
        { "id": "visual", "type": "decision", "label": "Attach visuals?" },
        { "id": "camera", "type": "activity", "label": "Use Camera (ImageSource.camera)" },
        { "id": "gallery", "type": "activity", "label": "Upload Media (pickMultiImage)" },
        { "id": "preview", "type": "activity", "label": "Show thumbnails (removable)" },
        { "id": "valid", "type": "decision", "label": "Issue filled + valid?" },
        { "id": "uploadimgs", "type": "activity", "label": "Upload images to Storage (reports/{id}/image_n.jpg, 70% JPEG)" },
        { "id": "savereport", "type": "activity", "label": "Push report {issue, sensorId, notes, imageUrls} to TANK_01/reports" },
        { "id": "notifyadmin", "type": "activity", "label": "Admin web Receive tab updates (realtime)" },
        { "id": "clear", "type": "activity", "label": "Clear form + show success snackbar" },
        { "id": "history", "type": "activity", "label": "Entry appears in worker Report History + admin Receive" },
        { "id": "end", "type": "end", "label": "Report delivered" }
      ],
      "edges": [
        { "from": "start", "to": "fill" },
        { "from": "fill", "to": "visual" },
        { "from": "visual", "to": "camera", "label": "camera" },
        { "from": "visual", "to": "gallery", "label": "gallery" },
        { "from": "visual", "to": "valid", "label": "skip" },
        { "from": "camera", "to": "preview" },
        { "from": "gallery", "to": "preview" },
        { "from": "preview", "to": "valid" },
        { "from": "valid", "to": "uploadimgs", "label": "yes" },
        { "from": "valid", "to": "fill", "label": "no (fix)" },
        { "from": "uploadimgs", "to": "savereport" },
        { "from": "savereport", "to": "notifyadmin" },
        { "from": "notifyadmin", "to": "clear" },
        { "from": "clear", "to": "history" },
        { "from": "history", "to": "end" }
      ]
    },
    {
      "id": "AD5",
      "name": "Admin Threshold Configuration (Web -> All Clients)",
      "description": "Admin changes safe ranges; mobile + ESP32 sync live.",
      "nodes": [
        { "id": "start", "type": "start", "label": "Admin opens System Configuration" },
        { "id": "edit", "type": "activity", "label": "Edit ph/temp/tds/waterlevel min-max values" },
        { "id": "save", "type": "activity", "label": "Save -> .set() flat contract to TANK_01/config/thresholds" },
        { "id": "rulesok", "type": "decision", "label": "Writer is admins/{uid} = true? (rules)" },
        { "id": "rejected", "type": "activity", "label": "Write rejected by security rules" },
        { "id": "onvalue", "type": "activity", "label": "RTDB onValue listeners fire on all clients" },
        { "id": "mobilesync", "type": "activity", "label": "Mobile dashboard STABLE/CAUTION re-evaluates instantly" },
        { "id": "esp32sync", "type": "activity", "label": "ESP32 fetches new thresholds (within 60s) for alert evaluation" },
        { "id": "websync", "type": "activity", "label": "Web KPI safe-range labels update" },
        { "id": "end", "type": "end", "label": "System-wide standard updated" }
      ],
      "edges": [
        { "from": "start", "to": "edit" },
        { "from": "edit", "to": "save" },
        { "from": "save", "to": "rulesok" },
        { "from": "rulesok", "to": "rejected", "label": "no" },
        { "from": "rulesok", "to": "onvalue", "label": "yes" },
        { "from": "onvalue", "to": "mobilesync" },
        { "from": "onvalue", "to": "esp32sync" },
        { "from": "onvalue", "to": "websync" },
        { "from": "mobilesync", "to": "end" },
        { "from": "esp32sync", "to": "end" },
        { "from": "websync", "to": "end" },
        { "from": "rejected", "to": "end" }
      ]
    }
  ],
  "legend": {
    "nodeTypes": {
      "start": "Initial node (filled circle)",
      "end": "Final node (bullseye)",
      "activity": "Action (rounded rectangle)",
      "decision": "Guard condition (diamond)"
    },
    "edgeLabels": "yes/no labels on decision branches; unlabeled edges are default flow"
  }
}
