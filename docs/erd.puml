@startuml AquaWatch_ERD
' ============================================================
'  AquaWatch — Entity Relationship Diagram
'  IoT-Based Water Quality Monitoring and Predictive
'  Alert System for Seabass Aquaculture
'
'  HOW TO RENDER:
'  1. Open https://plantuml.com/plantuml  (or planttext.com)
'  2. Paste this entire file into the editor
'  3. The diagram renders on the right — download as PNG/SVG
'
'  NOTE: Firebase RTDB is a NoSQL tree — this is a LOGICAL
'  ERD; references are application-maintained, not enforced
'  constraints. All timestamps are epoch milliseconds.
' ============================================================

hide circle
skinparam linetype ortho
skinparam backgroundColor #FAFAFA
skinparam entity {
  BackgroundColor White
  BorderColor #1a73e8
  FontName Arial
}

entity "User" as USER {
  * uid : string <<PK>>
  --
  name : string
  operatorId : string
  fcmToken : string
  settings.push : bool
  settings.sound : bool
  settings.vibration : bool
  createdAt : int64 (ms)
}

entity "Admin" as ADMIN {
  * uid : string <<PK, FK>>
  --
  isAdmin : bool (true)
}

entity "LiveReading\n(tank_status)" as LIVE {
  * (singleton per tank)
  --
  waterlevel : double (%)
  temperature : double (°C)
  ph : double
  tds : double (ppm)
  timestamp : int64 (ms)
}

entity "HistoryReading\n(TANK_01/history)" as HIST {
  * pushId : string <<PK>>
  --
  waterlevel : double (%)
  temperature : double (°C)
  ph : double
  tds : double (ppm)
  timestamp : int64 (ms)
}

entity "ThresholdConfig\n(config/thresholds)" as THRESH {
  * (singleton per tank)
  --
  ph_min : double
  ph_max : double
  temp_min : double
  temp_max : double
  tds_max : double
  waterlevel_min : double
  waterlevel_max : double
  updated_at : int64 (ms)
}

entity "IntervalConfig\n(config/interval_seconds)" as INTERVAL {
  * (singleton per tank)
  --
  interval_seconds : int
}

entity "Sensor\n(TANK_01/sensors)" as SENSOR {
  * sensorId : string <<PK>>
  --
  type : string
  installedAt : int64 (ms)
  lifespanDays : int
  expiresAt : int64 (ms)
  status : string <<active|replace|inactive>>
  removedAt : int64 (ms, optional)
}

entity "Alert\n(TANK_01/alerts)" as ALERT {
  * pushId : string <<PK>>
  --
  parameter : string <<FK>>
  value : double
  actionTaken : string
  severity : string <<critical|warning>>
  timestamp : int64 (ms)
}

entity "Report\n(TANK_01/reports)" as REPORT {
  * pushId : string <<PK>>
  --
  issue : string
  sensorId : string <<FK>>
  notes : string
  imageUrls : string[]
  timestamp : int64 (ms)
}

entity "SentMessage\n(reports/sent)" as SENT {
  * pushId : string <<PK>>
  --
  subject : string
  message : string
  sensorId : string <<FK>>
  workerId : string <<FK>>
  timestamp : int64 (ms)
}

entity "ReportImage\n(Firebase Storage)" as IMAGE {
  * downloadUrl : string <<PK>>
  --
  reportId : string <<FK>>
  path : TANK_01/reports/{id}/image_n.jpg
}

' ── Relationships ──────────────────────────────────────────

USER ||--o{ REPORT : "submits"
ADMIN ||--o{ SENT : "sends to worker"
USER ||--o| ADMIN : "flagged as"

SENSOR ||--o{ ALERT : "lifecycle\ntransition"
SENSOR ||--o{ REPORT : "auto-logs\nevent"
REPORT ||--o{ IMAGE : "contains"

THRESH ||--o{ ALERT : "governs ESP32\nevaluation"
LIVE ||--o{ HIST : "appends\nsnapshot"
INTERVAL ||--|| LIVE : "controls\ncadence"

ALERT }o--o{ USER : "pushed via\nFCM"
THRESH ..o{ HIST : "predictor evaluates\nTDS trend"

@enduml
